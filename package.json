{
  "name": "hao-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "A friendly interface to the Hymenoptera Anatomy Ontology (HAO): terms, synonyms with their literature, images and connections.",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "node scripts/build-data.mjs && vite",
    "build": "node scripts/build-data.mjs && vite build",
    "preview": "vite preview",
    "references": "node scripts/hymao-to-taxonworks.mjs",
    "references:update": "node scripts/hymao-to-taxonworks.mjs --write"
  },
  "dependencies": {
    "cytoscape": "3.28.1",
    "d3-hierarchy": "3.1.2",
    "d3-shape": "3.2.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "vite": "6.0.7"
  }
}
